# Meilisearch UI 环境变量模板
# 使用方式：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库。

# 163 邮箱 SMTP —— 用于 Token 申请的验证码邮件与审批通知
SMTP_USER=your-email@163.com
SMTP_PASS=your-163-smtp-auth-code

# JWT 签名密钥 —— 用于后台登录令牌签发/校验
# 建议生成方式：openssl rand -hex 32
# 留空时程序会自动生成并持久化到 backend/data/jwt_secret
JWT_SECRET=please-change-to-a-random-32-byte-hex
