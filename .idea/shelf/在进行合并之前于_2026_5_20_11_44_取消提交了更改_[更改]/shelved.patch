order-bottom: 1px solid var(--border);\n  padding-bottom: 12px;\n}\n.card-header h3 {\n  font-family: var(--font-title);\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: var(--primary);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n/* 数据表格 - 精致感十足 */\n.data-table {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 15px;\n}\n.data-table th {\n  text-align: left;\n  padding: 12px 16px;\n  color: var(--text-sub);\n  font-size: 13px;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  border-bottom: 2px solid var(--border);\n}\n.data-table td {\n  padding: 16px;\n  border-bottom: 1px solid var(--border);\n  font-size: 14px;\n}\n.data-table tr:hover td {\n  background: rgba(255, 255, 255, 0.02);\n}\n\n/* 状态标签 */\n.status-badge {\n  padding: 4px 10px;\n  border-radius: var(--radius-full);\n  font-size: 11px;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.status-ok { background: rgba(16, 185, 129, 0.1); color: #10b981; }\n.status-err { background: rgba(239, 68, 68, 0.1); color: #ef4444; }\n\n/* 滚动条美化 */\n::-webkit-scrollbar { width: 8px; height: 8px; }\n::-webkit-scrollbar-track { background: var(--bg-main); }\n::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }\n\n/* ============ 动画 ============ */\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.animate-fade-in {\n  animation: fadeIn 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;\n}\n\nhtml[data-theme=\"light\"] {\n  --bg-main: #f6f8fb;\n  --bg-app: #ffffff;\n  --bg-card: #ffffff;\n  --bg-card-hover: #f8fafc;\n  --text-main: #1f2937;\n  --text-sub: #4b5563;\n  --text-muted: #6b7280;\n  --border: #e5e7eb;\n  --border-active: #0f766e;\n  --glass-bg: rgba(255, 255, 255, 0.95);\n  --glass-blur: blur(10px);\n  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);\n  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);\n  --shadow-primary: 0 2px 4px rgba(15, 118, 110, 0.2);\n  --transition: all 0.2s ease;\n  --surface: #ffffff;\n  --surface-glass: rgba(255, 255, 255, 0.95);\n  --bg-secondary: #eef2f7;\n}\n\nhtml[data-theme=\"light\"] body {\n  background: #f6f8fb;\n}\n\nhtml[data-theme=\"light\"] .card {\n  background: #ffffff;\n  box-shadow: var(--shadow-md);\n  border: 1px solid #e5e7eb;\n}\n\nhtml[data-theme=\"light\"] .card:hover {\n  box-shadow: var(--shadow-lg);\n}\n\nhtml[data-theme=\"light\"] .card-header h3 {\n  color: var(--primary);\n}\n\nhtml[data-theme=\"light\"] .btn-secondary {\n  background: #ffffff;\n  border: 1px solid #e5e7eb;\n  color: #1f2937;\n}\n\nhtml[data-theme=\"light\"] .btn-secondary:hover {\n  background: #f9fafb;\n  border-color: #d1d5db;\n}\n\nhtml[data-theme=\"light\"] .form-control {\n  background: #ffffff;\n  border: 1px solid #d1d5db;\n  color: #1f2937;\n}\n\nhtml[data-theme=\"light\"] .form-control:focus {\n  border-color: var(--primary);\n  box-shadow: 0 0 0 3px rgba(var(--primary-color-rgb), 0.12);\n}\n\nhtml[data-theme=\"light\"] .form-control::placeholder {\n  color: #9ca3af;\n}\n\nhtml[data-theme=\"light\"] .app-header {\n  background: #ffffff;\n  border-bottom: 1px solid #e5e7eb;\n}\n\nhtml[data-theme=\"light\"] .glass-btn {\n  background: #f3f4f6;\n  border: 1px solid #e5e7eb;\n  color: #1f2937;\n}\n\nhtml[data-theme=\"light\"] .glass-btn:hover {\n  background: #e5e7eb;\n}\n\nhtml[data-theme=\"light\"] .user-pill {\n  background: #f3f4f6;\n  border: 1px solid #e5e7eb;\n}\n\nhtml[data-theme=\"light\"] .brand-text h1 {\n  color: #1f2937;\n}\n\nhtml[data-theme=\"light\"] .brand-text p {\n  color: #9ca3af;\n}\n\nhtml[data-theme=\"light\"] .nav-pill {\n  background: transparent;\n  color: #6b7280;\n}\n\nhtml[data-theme=\"light\"] .nav-pill:hover {\n  background: #f3f4f6;\n  color: #1f2937;\n}\n\nhtml[data-theme=\"light\"] .nav-pill.active {\n  background: var(--pri